# EditorConfig for Research-Engineering-OS
# https://editorconfig.org/

# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown files
[*.md]
max_line_length = off
trim_trailing_whitespace = false  # Preserve intentional trailing spaces in Markdown

# TOML files (mdBook configuration)
[*.toml]
indent_size = 2

# YAML files (GitHub Actions, config files)
[*.{yml,yaml}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2
end_of_line = lf

# Python files
[*.py]
indent_size = 4

# Makefiles (must use tabs)
[Makefile]
indent_style = tab
indent_size = 4

# JavaScript/TypeScript
[*.{js,ts,jsx,tsx}]
indent_size = 2

# CSS/SCSS
[*.{css,scss}]
indent_size = 2

# HTML
[*.html]
indent_size = 2
